# Copy to .env and adjust. Never commit .env.
# docker compose works without a .env (it falls back to these development defaults).

POSTGRES_USER=claimflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claimflow

# Used when running the backend directly on your machine (not inside Docker).
# Inside docker compose this is set automatically to point at the `db` service.
DATABASE_URL=postgresql+psycopg2://claimflow:change-me@localhost:5432/claimflow

# Optional overrides (defaults: <repo>/data and <repo>/evaluation_results)
# DATA_DIR=./data
# EVALUATION_OUTPUT_DIR=./evaluation_results

# ---- Phase 2: RAG + LLM (all optional; with LLM_PROVIDER=none the system runs the Phase 1 rules only) ----
LLM_PROVIDER=none              # none | anthropic | openai
LLM_MODEL=                     # e.g. claude-opus-5 (required when LLM_PROVIDER is not none)
ANTHROPIC_API_KEY=             # required for LLM_PROVIDER=anthropic. Never commit this.
# OPENAI_API_KEY=              # for LLM_PROVIDER=openai
# OPENAI_BASE_URL=             # any OpenAI-compatible server (vLLM, Ollama, ...)
# LLM_EFFORT=low               # Anthropic only, optional: low|medium|high|xhigh|max
# LLM_CONFIDENCE_THRESHOLD=0.80
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2            # retries AFTER the first attempt (max 1 + 2 calls per claim)
# LLM_BACKOFF_SECONDS=1.0
# LLM_INPUT_PRICE_PER_MTOK=    # optional USD per million tokens, to estimate cost. No defaults: prices change.
# LLM_OUTPUT_PRICE_PER_MTOK=
# RETRIEVAL_CONFIG=filtered    # baseline | chunking | query | filtered
# EMBEDDER=minilm              # minilm (real) | hashing (offline stand-in for tests)
# CHROMA_DIR=./chroma_db
